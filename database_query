-- Forecast runs saved by forecasting.php (monthly Holt's DES: complete months
-- plus the current month-to-date when it already holds sales, pro-rated to a
-- full-month equivalent; gate is 12 points; predicts the next full month).
-- Existing DBs: run just the MIGRATION block below once in phpMyAdmin instead.
-- (The retired daily-method forecasting_history table must be dropped first -
-- it is unread and unwritten. The migration does this for you.)
CREATE TABLE forecasting_history (
    id INT AUTO_INCREMENT PRIMARY KEY,
    product VARCHAR(50) NOT NULL,
    months_used INT NOT NULL,
    alpha DECIMAL(4,2) NOT NULL,
    beta DECIMAL(4,2) NULL,
    method VARCHAR(32) NOT NULL DEFAULT 'SES (monthly)',
    forecast_qty DECIMAL(10,2) NOT NULL,
    forecast_month CHAR(7) NOT NULL,
    monthly_json MEDIUMTEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL
);

