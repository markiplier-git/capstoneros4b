);

-- MIGRATION: Holt's DES + forecasting_monthly -> forecasting_history (2026-10-01):
-- Run this in phpMyAdmin. The old daily-method forecasting_history table is
-- retired (unread, unwritten), so it is dropped first to free the name; then
-- forecasting_monthly is renamed and gains beta + method columns. All saved
-- runs are preserved; old SES rows get method 'SES (monthly)' and beta NULL.
DROP TABLE IF EXISTS forecasting_history;
ALTER TABLE forecasting_monthly RENAME TO forecasting_history;
ALTER TABLE forecasting_history
ADD beta DECIMAL(4,2) NULL AFTER alpha,
ADD method VARCHAR(32) NOT NULL DEFAULT 'SES (monthly)' AFTER beta;
ALTER TABLE forecasting_history DROP INDEX idx_forecasting_monthly_created;
CREATE INDEX idx_forecasting_history_created ON forecasting_history(created_at);

